// Implements the canonical entities in ../../docs/data-model.md.
// Tenant / InternalUser / SupplierContact are the auth/tenancy substrate that
// doc doesn't cover at field level (it's scoped to the procurement domain).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Tenancy & users ---

model Tenant {
  id   String @id @default(cuid())
  name String

  // The tenant's own path segment, and the identity a federated identity
  // provider knows us by: `/api/sso/{slug}/callback` is the address a
  // customer configures, and `{APP_BASE_URL}/sso/saml/{slug}` is the audience
  // every assertion for them must name. Both matter because two customers can
  // federate from the same identity provider — a per-tenant audience is what
  // makes one of their sign-ins unusable at the other.
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One document-number space for the whole tenant, shared by POs, RFQs and
  // price lists — `P-10418`, `Q-10419`, `L-10420`. Deliberately not a
  // per-entity sequence: one space means the bare number `10418` is
  // unambiguous read down a phone, which is how suppliers actually use it.
  // Allocated with a single atomic `UPDATE ... RETURNING` (see
  // src/lib/document-number.ts), never by counting existing rows.
  nextDocumentNumber Int @default(10001)

  internalUsers          InternalUser[]
  suppliers              Supplier[]
  priceLists             PriceList[]
  purchaseOrders         PurchaseOrder[]
  rfqs                   RFQ[]
  poSuggestions          POSuggestion[]
  actionItems            ActionItem[]
  locations              Location[]
  statusEvents           StatusEvent[]
  integrationConnections IntegrationConnection[]
  domains                TenantDomain[]
  directoryTokens        DirectoryToken[]
  directoryGroups        DirectoryGroup[]
  directoryEvents        DirectoryEvent[]
  ssoAuthRequests        SsoAuthRequest[]
}

enum InternalUserRole {
  OWNER
  MEMBER
}

// Whether someone is still on the team.
//
// Phase 1b decided against this column, and said why in
// src/app/actions/team.ts: the session layer treats a session pointing at a
// missing user as unauthenticated, and rotating the password hash to
// something unguessable was a lockout that preserved every foreign key
// pointing at the row. That reasoning held exactly as long as a password was
// the only door. A federated user has no password, so the rotation locks out
// nobody, and it silently becomes a no-op for precisely the population an
// offboarding is about. Hence a real status, read on every request by
// src/lib/dal.ts.
enum InternalUserStatus {
  ACTIVE
  DEACTIVATED
}

model InternalUser {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  email    String

  // Nullable since Phase 3: a user provisioned by a directory, or created on
  // a first federated sign-in, never has one. Every read is guarded —
  // bcrypt.compare against null throws, and a null hash must never be
  // treated as "any password matches".
  passwordHash String?

  name          String
  role          InternalUserRole   @default(MEMBER)
  status        InternalUserStatus @default(ACTIVE)
  deactivatedAt DateTime?

  // Where this person came from, when it wasn't a hand-made account:
  // `okta` plus the directory's own stable key. Matched on for every
  // federated sign-in, which is why the key is never the email — a directory
  // can change an address, and an account matched on a mutable value is an
  // account somebody else can be handed.
  sourceIntegrationId String?
  externalRef         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cancelledPurchaseOrders PurchaseOrder[]         @relation("POCancelledBy")
  actionItems             ActionItem[]            @relation("ActionItemInternalOwner")
  resolvedActionItems     ActionItem[]            @relation("ActionItemResolvedBy")
  locations               InternalUserLocation[]
  integrationConnections  IntegrationConnection[] @relation("IntegrationConnectedBy")
  directoryGroups         DirectoryGroupMember[]
  directoryEvents         DirectoryEvent[]        @relation("DirectoryEventSubject")
  issuedDirectoryTokens   DirectoryToken[]        @relation("DirectoryTokenCreatedBy")

  @@unique([tenantId, email])
  // Postgres treats NULLs as distinct in a unique index, so every
  // password-only account coexists here with no backfill.
  @@unique([tenantId, sourceIntegrationId, externalRef])
}

// Comparable to (simpler than) Epicor's Company -> Site structure: Tenant
// plays Company, Location plays Site — no separate Company layer. See
// docs/data-model.md#location.
enum LocationStatus {
  ACTIVE
  INACTIVE
}

model Location {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  name                String
  code                String
  sourceIntegrationId String?
  externalRef         String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  region              String?
  postalCode          String?
  country             String?
  status              LocationStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  assignedUsers      InternalUserLocation[]
  purchaseOrderLines PurchaseOrderLine[]
  rfqLines           RFQLine[]
  directoryGroups    DirectoryGroupLocation[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// Where a location assignment came from. `@@unique([internalUserId,
// locationId])` means one row cannot carry both provenances, so the
// precedence rule has to be stated rather than implied: a MANUAL grant always
// wins and is never revoked by a directory push, and a DIRECTORY grant is
// withdrawn when the group that issued it stops applying. Without the rule,
// removing someone from a pushed group either destroys a hand-made grant
// nobody will know to recreate, or leaves a departed user holding a site's
// orders.
enum LocationAssignmentSource {
  MANUAL
  DIRECTORY
}

model InternalUserLocation {
  id               String                   @id @default(cuid())
  internalUserId   String
  internalUser     InternalUser             @relation(fields: [internalUserId], references: [id])
  locationId       String
  location         Location                 @relation(fields: [locationId], references: [id])
  source           LocationAssignmentSource @default(MANUAL)
  grantedByGroupId String?
  grantedByGroup   DirectoryGroup?          @relation(fields: [grantedByGroupId], references: [id])
  createdAt        DateTime                 @default(now())

  @@unique([internalUserId, locationId])
  @@index([grantedByGroupId])
}

// No passwordHash here on purpose: persistent supplier accounts are deferred
// out of v1 (docs/todo.md#decided) — the scoped action-view link is the entire
// external auth surface.
enum SupplierContactStatus {
  ACTIVE
  INACTIVE
}

model SupplierContact {
  id         String                @id @default(cuid())
  supplierId String
  supplier   Supplier              @relation(fields: [supplierId], references: [id])
  name       String
  email      String
  // Contacts are never deleted — an INACTIVE contact stops receiving the
  // chase but keeps its history and its already-resolved action items
  // intact. Reminders addressed to someone who left the supplier are how a
  // chase silently stops working.
  status     SupplierContactStatus @default(ACTIVE)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  actionItems     ActionItem[]           @relation("ActionItemExternalOwner")
  resolvedItems   ActionItem[]           @relation("ActionItemResolvedByContact")
  changeProposals POLineChangeProposal[]

  @@unique([supplierId, email])
}

// --- Procurement domain ---

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  name                String
  sourceIntegrationId String?
  externalRef         String?
  primaryContactName  String?
  primaryContactEmail String?
  status              SupplierStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  contacts       SupplierContact[]
  priceLists     PriceList[]
  purchaseOrders PurchaseOrder[]
  rfqInvites     RFQSupplierInvite[]
  rfqQuotes      RFQQuote[]
  poSuggestions  POSuggestion[]

  @@index([tenantId])
}

model PriceList {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  // Human-readable document number, `L-10007`. See Tenant.nextDocumentNumber.
  number              String
  supplierId          String
  supplier            Supplier  @relation(fields: [supplierId], references: [id])
  sourceIntegrationId String?
  externalRef         String?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items PriceListItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([supplierId])
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  itemNumber  String
  description String
  uom         String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  priceBreaks PriceBreak[]

  @@index([priceListId])
}

model PriceBreak {
  id              String        @id @default(cuid())
  priceListItemId String
  priceListItem   PriceListItem @relation(fields: [priceListItemId], references: [id])
  minQuantity     Int
  unitPrice       Decimal       @db.Decimal(14, 4)
  currency        String        @default("USD")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([priceListItemId])
}

// draft -> issued -> acknowledged -> in_progress -> fulfilled -> closed,
// with rejected (supplier) and cancelled (buyer) as explicit exits —
// see docs/data-model.md#purchaseorder.
enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  REJECTED
  IN_PROGRESS
  FULFILLED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  // Human-readable document number, `P-10418`. See Tenant.nextDocumentNumber.
  number              String
  sourceIntegrationId String?
  externalRef         String?
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  status              PurchaseOrderStatus @default(DRAFT)

  // Denormalized sum of line quantity * unitPrice, maintained by every write
  // path that touches lines (src/lib/po-total.ts). Exists so "rank by dwell
  // x value" and "$1.4M issued and unacknowledged" are one indexed query
  // rather than a full line scan — the ordering rule the whole product is
  // built on can't be a post-fetch sort once a tenant has 900 orders.
  // 18,4 rather than 14,4: a *line* is Decimal(14,4) x Decimal(14,4), so an
  // order total can legitimately need more integer digits than either factor.
  // Sized so it cannot overflow for any in-bounds input — the real bound is
  // input validation on quantity and price, which Phase 1b Wave 5 adds; until
  // then the seeded dev data contains a $12T order proving the point.
  totalValue Decimal @default(0) @db.Decimal(18, 4)

  // Lifecycle timestamps. Redundant with StatusEvent by design: the event
  // table is the record (and what the possession strip reads), these are the
  // index the scorecards aggregate over. Both are written by the single
  // recordStatusChange() helper, so they can't drift.
  issuedAt       DateTime?
  acknowledgedAt DateTime?
  fulfilledAt    DateTime?
  closedAt       DateTime?

  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledByUser    InternalUser? @relation("POCancelledBy", fields: [cancelledByUserId], references: [id])
  cancellationReason String?

  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PurchaseOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([supplierId])
  @@index([tenantId, status])
}

enum PurchaseOrderLineStatus {
  PENDING_ACKNOWLEDGMENT
  ACKNOWLEDGED
  CHANGE_PROPOSED
  PARTIALLY_RECEIVED
  FULFILLED
  CLOSED
  CANCELLED
}

model PurchaseOrderLine {
  id              String                  @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  lineNumber      Int
  itemNumber      String
  description     String
  uom             String
  quantity        Decimal                 @db.Decimal(14, 4)
  unitPrice       Decimal                 @db.Decimal(14, 4)
  // Nullable for migration flexibility; the create-PO flow requires it in
  // practice — see docs/data-model.md#purchaseorderline.
  locationId      String?
  location        Location?               @relation(fields: [locationId], references: [id])
  needByDate      DateTime?
  promiseDate     DateTime?
  status          PurchaseOrderLineStatus @default(PENDING_ACKNOWLEDGMENT)

  // The *live* proposal, nulled once the buyer decides. The decision itself
  // and the values it concerned are preserved in POLineChangeProposal —
  // without that, accepting a proposal destroyed the only evidence it ever
  // happened, and change-proposal rate is a supplier-scorecard metric.
  proposedQuantity          Decimal?  @db.Decimal(14, 4)
  proposedUnitPrice         Decimal?  @db.Decimal(14, 4)
  proposedDate              DateTime?
  proposedBySupplierContact String?
  proposedAt                DateTime?

  // Receipt, recorded per line by the buyer; the header rolls up to
  // FULFILLED once every line is terminal.
  receivedAt       DateTime?
  receivedQuantity Decimal?  @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeProposals POLineChangeProposal[]

  @@index([purchaseOrderId])
}

enum ChangeProposalOutcome {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

// Immutable history of supplier-proposed line changes and what the buyer did
// about them. `PurchaseOrderLine.proposed*` holds only the open proposal;
// this holds every one that was ever made, so "change-proposal rate" and
// "average date slip" (docs/product.md's supplier scorecard) are answerable
// after the fact.
model POLineChangeProposal {
  id                  String            @id @default(cuid())
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  // Values as they stood when the proposal was made, so a diff is
  // reconstructible without replaying the whole line history.
  previousQuantity  Decimal   @db.Decimal(14, 4)
  previousUnitPrice Decimal   @db.Decimal(14, 4)
  previousDate      DateTime?

  proposedQuantity  Decimal   @db.Decimal(14, 4)
  proposedUnitPrice Decimal   @db.Decimal(14, 4)
  proposedDate      DateTime?

  proposedByContactId String?
  proposedByContact   SupplierContact? @relation(fields: [proposedByContactId], references: [id])
  proposedByName      String
  proposedAt          DateTime         @default(now())

  outcome         ChangeProposalOutcome @default(PENDING)
  decidedAt       DateTime?
  decidedByUserId String?
  decisionNote    String?

  @@index([purchaseOrderLineId])
}

enum RFQStatus {
  DRAFT
  SENT
  RESPONSES_OPEN
  AWARDED
  CLOSED
}

model RFQ {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  // Human-readable document number, `Q-10422`. See Tenant.nextDocumentNumber.
  number   String
  status   RFQStatus @default(DRAFT)

  // Without a deadline the response window is unbounded and there is nothing
  // to escalate against — the chase has no terminal branch.
  quoteDeadline DateTime?

  sentAt    DateTime?
  awardedAt DateTime?
  closedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resolves the docs/data-model.md open question of how the winning quote
  // is recorded: explicit FK, set only on award. Whether award auto-creates
  // a PurchaseOrder is still open — v1 treats that as a separate buyer
  // action, not automatic.
  awardedQuoteId String?   @unique
  awardedQuote   RFQQuote? @relation("RFQAwardedQuote", fields: [awardedQuoteId], references: [id])

  lines   RFQLine[]
  invites RFQSupplierInvite[]
  quotes  RFQQuote[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
}

model RFQLine {
  id          String    @id @default(cuid())
  rfqId       String
  rfq         RFQ       @relation(fields: [rfqId], references: [id])
  itemNumber  String
  description String
  uom         String
  quantity    Decimal   @db.Decimal(14, 4)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  needByDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  quoteLines RFQQuoteLine[]

  @@index([rfqId])
}

enum RFQSupplierInviteStatus {
  INVITED
  RESPONDED
  DECLINED
}

model RFQSupplierInvite {
  id          String                  @id @default(cuid())
  rfqId       String
  rfq         RFQ                     @relation(fields: [rfqId], references: [id])
  supplierId  String
  supplier    Supplier                @relation(fields: [supplierId], references: [id])
  status      RFQSupplierInviteStatus @default(INVITED)
  // Per-invitee response timing — the RFQ list draws one square per invitee
  // at *that invitee's* own dwell, which a single RFQ-level timestamp can't
  // express. Also feeds the supplier scorecard's RFQ response rate.
  respondedAt DateTime?
  declinedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([rfqId, supplierId])
}

enum RFQQuoteStatus {
  PENDING
  SUBMITTED
  WITHDRAWN
}

model RFQQuote {
  id          String         @id @default(cuid())
  rfqId       String
  rfq         RFQ            @relation(fields: [rfqId], references: [id])
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  status      RFQQuoteStatus @default(PENDING)
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lines RFQQuoteLine[]

  awardedFor RFQ? @relation("RFQAwardedQuote")

  @@unique([rfqId, supplierId])
}

model RFQQuoteLine {
  id           String   @id @default(cuid())
  rfqQuoteId   String
  rfqQuote     RFQQuote @relation(fields: [rfqQuoteId], references: [id])
  rfqLineId    String
  rfqLine      RFQLine  @relation(fields: [rfqLineId], references: [id])
  unitPrice    Decimal  @db.Decimal(14, 4)
  leadTimeDays Int
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([rfqQuoteId, rfqLineId])
}

enum POSuggestionStatus {
  OPEN
  ACCEPTED
  REJECTED
  SUPERSEDED
}

model POSuggestion {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  sourceIntegrationId String
  externalRef         String
  supplierId          String
  supplier            Supplier           @relation(fields: [supplierId], references: [id])
  itemNumber          String
  description         String
  suggestedQuantity   Decimal            @db.Decimal(14, 4)
  suggestedDate       DateTime
  suggestedUnitPrice  Decimal?           @db.Decimal(14, 4)
  status              POSuggestionStatus @default(OPEN)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tenantId])
}

enum ActionItemSubjectType {
  PURCHASE_ORDER
  PURCHASE_ORDER_LINE
  RFQ
  PO_SUGGESTION
  INTEGRATION_CONNECTION
}

// Every non-terminal state of a PO or RFQ maps to exactly one of these, and
// each one names who owes what. A state with no entry here is a modeling bug
// (docs/product.md) — the audit in src/lib/lifecycle.ts is the executable
// version of that claim. See docs/data-model.md#actionitem.
enum ActionItemType {
  // Buyer owes: a draft nobody has issued is work sitting still.
  PO_ISSUE_DRAFT
  // Supplier owes: acknowledge an issued PO.
  PO_ACKNOWLEDGE
  // Buyer owes: decide on a supplier's proposed line change.
  PO_REVIEW_CHANGE_PROPOSAL
  // Buyer owes: respond to a supplier's rejection (revise, or cancel).
  PO_REVIEW_REJECTION
  // Supplier owes: deliver what they acknowledged. Open from acknowledgment
  // until every line is received — this is what "they owe 11" counts.
  PO_DELIVER
  // Buyer owes: close out a fully-received PO.
  PO_CLOSE
  // Buyer owes: send a drafted RFQ to its invited suppliers.
  RFQ_SEND_DRAFT
  // Supplier owes: submit a quote (one per invited contact).
  RFQ_SUBMIT_QUOTE
  // Buyer owes: award or close an RFQ that has quotes in.
  RFQ_AWARD_DECISION
  // Buyer owes: raise the PO an award implies. Awarding does not create one
  // automatically (docs/data-model.md), so without this the winning quote
  // silently goes nowhere.
  RFQ_RAISE_PO_FROM_AWARD
  PO_SUGGESTION_REVIEW
  // Buyer owes: repair a broken ERP/IdP connection. docs/todo.md named the
  // absence of this as a known hole — "by our own doctrine a stale ERP
  // connection is an open action owned by someone, so it belongs on the
  // board." A DEGRADED connection silently starving every downstream feature
  // is exactly the unowned state product.md calls a modeling bug.
  INTEGRATION_RECONNECT
}

enum ActionItemOwnerType {
  INTERNAL_USER
  EXTERNAL_USER
}

enum ActionItemStatus {
  OPEN
  RESOLVED
  SUPERSEDED
}

model ActionItem {
  id          String                @id @default(cuid())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  subjectType ActionItemSubjectType
  subjectId   String
  actionType  ActionItemType
  ownerType   ActionItemOwnerType

  internalOwnerId String?
  internalOwner   InternalUser?    @relation("ActionItemInternalOwner", fields: [internalOwnerId], references: [id])
  externalOwnerId String?
  externalOwner   SupplierContact? @relation("ActionItemExternalOwner", fields: [externalOwnerId], references: [id])

  status ActionItemStatus @default(OPEN)

  // Bearer token for the no-login "action view" link (docs/architecture.md
  // #action-items--reminders). Scoped to this one action item; valid for as
  // long as status stays OPEN — not single-use, not separately time-limited.
  accessToken String @unique

  openedAt   DateTime  @default(now())
  resolvedAt DateTime?

  // Who actually closed it. Attribution the buyer scorecard needs (resolution
  // latency by user) and the supplier receipt reads ("Sam Supplier confirmed
  // ..."), neither of which is recoverable from ownership alone — an OWNER
  // can resolve an item assigned to someone else.
  resolvedByInternalUserId String?
  resolvedByInternalUser   InternalUser?    @relation("ActionItemResolvedBy", fields: [resolvedByInternalUserId], references: [id])
  resolvedByContactId      String?
  resolvedByContact        SupplierContact? @relation("ActionItemResolvedByContact", fields: [resolvedByContactId], references: [id])

  // Chase state. `Chase all N` aggregates by recipient and needs a
  // server-side cooldown — the alternative is a per-row nudge button aimed
  // at the most-distributed surface we own. reminderCount is shown to the
  // buyer only, never to the supplier.
  lastRemindedAt DateTime?
  reminderCount  Int       @default(0)

  @@index([tenantId])
  @@index([internalOwnerId])
  @@index([externalOwnerId])
  @@index([tenantId, status, ownerType])
  @@index([subjectType, subjectId, status])
}

enum StatusEventSubjectType {
  PURCHASE_ORDER
  PURCHASE_ORDER_LINE
  RFQ
}

enum StatusEventActorType {
  INTERNAL_USER
  EXTERNAL_USER
  SYSTEM
}

// The transition log docs/product.md promises the scorecards are "built on".
// Append-only: one row per state change, whoever caused it. Two things need
// it that nothing else can supply — the possession strip (contiguous
// [draft][you][them] segments across an order's whole life) and any metric
// about *how long* a state lasted rather than which state something is in.
// Written only via recordStatusChange(), which also updates the matching
// denormalized timestamp on the entity.
model StatusEvent {
  id          String                 @id @default(cuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  subjectType StatusEventSubjectType
  subjectId   String
  fromStatus  String?
  toStatus    String

  actorType      StatusEventActorType
  actorUserId    String?
  actorContactId String?
  // Denormalized display name, captured at write time: a contact can be
  // deactivated or a user removed, and the history still has to read.
  actorLabel     String?

  note       String?
  occurredAt DateTime @default(now())

  @@index([tenantId])
  @@index([subjectType, subjectId, occurredAt])
}

// Outbound email captured by the dev mailbox instead of being delivered —
// only written while no real email provider is configured (EMAIL_PROVIDER
// unset; see src/lib/email/sender.ts), and read only by /dashboard/emails,
// which 404s once a provider is set. Deliberately not tenant-scoped: this
// simulates the mail server, not a product entity.
model CapturedEmail {
  id          String   @id @default(cuid())
  toEmail     String
  // `Acme Manufacturing via ZenoSource` — the buyer's name first, ours
  // second. Suppliers ignore no-reply automation and answer humans, and the
  // From line is the first thing they read.
  fromName    String   @default("ZenoSource")
  fromEmail   String   @default("notifications@zenosource.example")
  // The named buyer, so hitting reply reaches a person. Two header fields;
  // the highest leverage-to-effort item in the whole design review.
  replyTo     String?
  subject     String
  // The line under the subject in every mail client. Unset, clients fill it
  // with whatever the first line of the body happens to be.
  previewText String?
  textBody    String
  htmlBody    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// --- Integrations ----------------------------------------------------------
//
// The persistent half of the capability model in ../../docs/architecture.md
// #extensibility--capability-model. The *declarations* — which integrations
// exist, which capabilities each provides, which features need which
// capability — are code, not rows: they ship with the build, they're the same
// for every tenant, and putting them in the database would mean a migration
// to add a feature flag. See src/lib/integrations/registry.ts.
//
// What is per-tenant, and therefore lives here: whether this tenant has
// actually connected a given integration, the credentials it connected with,
// and whether those credentials still work. That last part is what turns the
// registry from a static list into a gate — a tenant's live capability set is
// derived from the CONNECTED rows below, so a connection going bad withdraws
// the features it was feeding.

enum IntegrationConnectionStatus {
  // Configured and last known to work. The only status that grants
  // capabilities — see capabilitiesForTenant().
  CONNECTED
  // Configured, but the most recent health check failed. Capabilities are
  // withdrawn (a feature reading stale ERP data is worse than an absent
  // one) and an INTEGRATION_RECONNECT action item is opened against an
  // OWNER, because nothing else in the product would tell anyone.
  DEGRADED
  // Explicitly disconnected by the tenant. Config is kept so reconnecting
  // isn't a re-onboarding, but secrets are wiped.
  DISCONNECTED
}

// Epicor's Kinetic REST API needs *two* independent credentials on every
// call — an API Key tied to an Access Scope, and an identity credential
// (Basic, or a Bearer token from TokenResource.svc). docs/integrations.md
// #epicor-erp: "Missing either fails differently — the connection-health
// check and onboarding flow need to distinguish the two failure modes, not
// report one generic 'auth failed.'" A buyer's IT admin can fix exactly one
// of these, and telling them the wrong one costs a support cycle.
enum IntegrationHealthFailure {
  NONE
  // The API key was missing, revoked, or its Access Scope doesn't cover the
  // services we call. Fixed in Epicor's API Key Maintenance.
  API_KEY
  // The API key was accepted; the user/password or OAuth2 token was not.
  // Fixed by re-entering the service account, not by touching the key.
  IDENTITY
  // Neither credential was ever judged — DNS, TLS, timeout, 5xx. Nothing is
  // wrong with the tenant's setup and re-entering credentials won't help.
  UNREACHABLE
  // Reachable and authenticated, but pointed somewhere wrong — bad base URL
  // or company id, or a BO/BAQ we require isn't present on this instance.
  CONFIGURATION
}

model IntegrationConnection {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Matches an id in the code registry (`epicor`, `okta`). Deliberately a
  // string and not an enum: adding an integration must not be a migration,
  // which is the whole promise of ../../docs/architecture.md's "a new
  // integration should only ever need to implement its own subproject,
  // declare its capabilities, and map its data."
  integrationId String
  status        IntegrationConnectionStatus @default(DISCONNECTED)

  // Non-secret connection settings, shape owned and validated by the
  // integration itself (Epicor: base URL, company, auth mode). Opaque here
  // for the same reason integrationId is a string.
  config Json?

  // Secrets, AES-256-GCM sealed with INTEGRATION_SECRET_KEY — never the
  // plaintext. This is a shared multi-tenant database holding what is
  // usually an ERP service account, so plaintext-at-rest would be the single
  // worst row in the schema. src/lib/integrations/secrets.ts owns the format
  // and documents what this does and doesn't protect against; Phase 5's
  // security review is where a real KMS/envelope scheme gets decided.
  secretsSealed String?

  connectedAt       DateTime?
  connectedByUserId String?
  connectedByUser   InternalUser? @relation("IntegrationConnectedBy", fields: [connectedByUserId], references: [id])

  // Health. lastHealthyAt is kept separately from lastCheckedAt so "broken
  // for six hours" and "broken since March" are distinguishable — the chase
  // ranks by dwell, and a connection is chased on the same clock as
  // everything else.
  lastCheckedAt DateTime?
  lastHealthyAt DateTime?
  healthFailure IntegrationHealthFailure @default(NONE)
  // Operator-facing detail behind the failure mode: the BO that 404'd, the
  // status line, the scope that was missing. Never rendered to suppliers.
  healthDetail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncRuns        IntegrationSyncRun[]
  directoryTokens DirectoryToken[]
  directoryGroups DirectoryGroup[]
  directoryEvents DirectoryEvent[]

  // One connection per integration per tenant. A second Epicor connection
  // would mean two sources of truth for the same PO.
  @@unique([tenantId, integrationId])
  @@index([tenantId])
  @@index([status])
}

enum IntegrationSyncOutcome {
  RUNNING
  SUCCEEDED
  // Finished, but individual records failed to map or persist. The run is
  // still useful — partial sync beats none — but the count is surfaced.
  PARTIAL
  FAILED
}

// One row per resource per sync attempt. Exists for the same reason
// StatusEvent does: "when did this last actually work, and what did it do"
// is not recoverable from the current state of the mirrored rows. It is also
// what Phase 5's "load/perf pass on Epicor sync paths" measures against.
model IntegrationSyncRun {
  id           String                @id @default(cuid())
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // `suppliers`, `purchase_orders`, `price_lists`, `po_suggestions` — the
  // canonical resource, not the vendor's BO name. Epicor's VendorSvc is an
  // implementation detail that must not surface in platform tables.
  resource String

  startedAt  DateTime               @default(now())
  finishedAt DateTime?
  outcome    IntegrationSyncOutcome @default(RUNNING)

  created Int @default(0)
  updated Int @default(0)
  skipped Int @default(0)
  failed  Int @default(0)

  // First failure's message, truncated. Full detail belongs in logs, not in
  // a row every tenant's admin page reads.
  error String?

  // Cursor for the next incremental pull — Epicor's ChangedDate watermark.
  // Stored per resource because the BOs move at wildly different rates:
  // suppliers change monthly, PO releases change hourly.
  watermark DateTime?

  @@index([connectionId, resource, startedAt])
}

// --- Federation and the directory ------------------------------------------
//
// Phase 3. The per-tenant *settings* of an identity provider — issuer, client
// id, certificates, protocol — deliberately do NOT live here: they go in
// IntegrationConnection.config and .secretsSealed like every other
// integration's, because ../../docs/architecture.md promises that adding an
// integration is a subproject and a registry entry, not a migration. What is
// below is only what the platform itself owns and has to index, query across
// tenants, or write on a hot path.

// Which email domains route to which tenant.
//
// Global uniqueness is the whole security property. Two tenants claiming
// acme.com is not a preference to resolve later — it decides whose identity
// provider gets to authenticate an address — so a unique index makes it
// impossible rather than unlikely.
//
// `verifiedAt` is set by an OWNER on the SSO settings page, which proves that
// an owner typed it and nothing more. That is honest while tenants exist only
// through prisma/seed.ts; it stops being enough the moment Phase 4 ships
// signup, and docs/todo.md says so where it can't be missed.
model TenantDomain {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  domain     String
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([domain])
  @@index([tenantId])
}

// The bearer a customer's directory authenticates with.
//
// Hashed, not sealed. src/lib/integrations/secrets.ts is reversible because an
// ERP credential has to be replayed outbound; this one is only ever verified,
// and a fresh-IV seal cannot be looked up by the value someone presents.
// bcrypt is the wrong tool too — this is 32 bytes of entropy, not a password,
// and a ~100ms hash per request across a bulk import is a timeout.
//
// docs/integrations.md: "that token *is* the tenant boundary: a bug that lets
// one tenant's SCIM token touch another tenant's users is a severe
// multi-tenancy breach." Several rows per connection on purpose, so a rotation
// can overlap rather than requiring a cutover with a window where provisioning
// is broken.
model DirectoryToken {
  id           String                @id @default(cuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // What an admin called it, so revoking the right one doesn't need a guess.
  name      String
  tokenHash String @unique
  // `••••••1a2b` — enough to tell two tokens apart without reproducing either.
  tokenHint String

  createdAt       DateTime      @default(now())
  createdByUserId String?
  createdByUser   InternalUser? @relation("DirectoryTokenCreatedBy", fields: [createdByUserId], references: [id])
  lastUsedAt      DateTime?
  revokedAt       DateTime?

  @@index([tenantId])
  @@index([connectionId])
}

// A group the customer's directory pushed to us.
//
// Inert until an OWNER maps it. `mappedRole` is MEMBER or nothing — never
// OWNER, refused in src/lib/directory/mapping.ts and not merely absent from
// the form: OWNER is "a strictly larger permission than anything else in the
// product" (src/app/actions/integrations.ts), and a group rename in somebody
// else's console must not be able to grant it.
model DirectoryGroup {
  id           String                @id @default(cuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  externalRef String
  displayName String
  mappedRole  InternalUserRole?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            DirectoryGroupMember[]
  locations          DirectoryGroupLocation[]
  grantedAssignments InternalUserLocation[]

  @@unique([connectionId, externalRef])
  @@index([tenantId])
}

model DirectoryGroupMember {
  id             String         @id @default(cuid())
  groupId        String
  group          DirectoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  internalUserId String
  internalUser   InternalUser   @relation(fields: [internalUserId], references: [id])
  createdAt      DateTime       @default(now())

  @@unique([groupId, internalUserId])
  @@index([internalUserId])
}

// Which locations membership of a group grants. Without this a provisioned
// MEMBER has no location at all, and src/lib/access.ts gives them a
// permanently empty board — the "why is my list empty" problem Phase 1b spent
// a wave fixing, arriving through the directory instead of by hand.
model DirectoryGroupLocation {
  id         String         @id @default(cuid())
  groupId    String
  group      DirectoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  locationId String
  location   Location       @relation(fields: [locationId], references: [id])

  @@unique([groupId, locationId])
}

enum DirectoryEventKind {
  USER_CREATED
  USER_UPDATED
  USER_ADOPTED
  USER_DEACTIVATED
  USER_REACTIVATED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  GROUP_MEMBERSHIP_CHANGED
  GRANTS_RECOMPUTED
  OPERATION_REFUSED
}

// Provisioning operations, applied and refused.
//
// The refusals are the reason this table exists. A last-owner deactivation
// that we correctly declined writes no status anywhere else in the product,
// and it is exactly what Phase 5's "security review of multi-tenant auth
// boundaries, ... SCIM token scoping in particular" goes looking for.
//
// Not StatusEvent: that table's subject types are the three document types and
// its rows feed the scorecards' possession maths, so directory rows would
// corrupt every number built from it. Not a sign-in log either — an audit
// trail carrying addresses and IPs is the first tenant PII in this schema and
// its retention is a decision, which is Phase 5's.
model DirectoryEvent {
  id           String                 @id @default(cuid())
  tenantId     String
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  connectionId String?
  connection   IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  kind           DirectoryEventKind
  internalUserId String?
  internalUser   InternalUser?      @relation("DirectoryEventSubject", fields: [internalUserId], references: [id])

  // An address or a group name, so a row still says who it was about after
  // the thing it referred to is gone.
  subjectHint String?
  // Why a refusal was refused, in the sentence the directory was given.
  reason      String?
  // Canonical fields written by platform code — never the protocol adapter's
  // raw body, or the boundary rule loses to the audit table.
  detail      Json?

  occurredAt DateTime @default(now())

  @@index([tenantId, occurredAt])
}

enum SsoProtocol {
  OIDC
  SAML
}

// One in-flight sign-in.
//
// Single-use, via one atomic `UPDATE ... WHERE consumedAt IS NULL RETURNING` —
// the same shape src/lib/document-number.ts uses and documents, so a replay is
// closed by the statement rather than by a read-then-write race.
//
// A cookie cannot do this job alone. src/lib/session.ts sets `sameSite: "lax"`,
// and a Lax cookie is not sent on the cross-site POST that a SAML response
// arrives as — so a cookie-only design works for one protocol and silently
// fails for the other. The cookie is still here, as a second factor binding
// the response to the browser that started it; both must agree.
model SsoAuthRequest {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  integrationId String
  protocol      SsoProtocol

  // 32 random bytes, base64url. This is the entire round-trip value: it is
  // what goes in the protocol's own state slot, and it carries no meaning, so
  // there is no code path that can interpret an identity provider's echo as a
  // URL. Where to land afterwards is `redirectTo` on this row.
  handle    String  @unique
  // The protocol-level request id we minted, which the response must quote.
  requestId String
  nonce     String?

  // Plaintext, deliberately. Sealing it would make sign-in depend on
  // INTEGRATION_SECRET_KEY, and apps/platform/CLAUDE.md promises the app runs
  // without one; anyone who can read this row can read the connection it
  // belongs to; and the row lives ten minutes.
  codeVerifier String?

  // sha256 of the short-lived browser cookie. Without it, anyone who obtains
  // a handle can finish somebody else's sign-in in their own browser.
  browserBindingHash String

  redirectTo String    @default("/dashboard")
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([tenantId])
  @@index([expiresAt])
}
